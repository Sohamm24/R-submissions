install.packages("keras3")
library(EBImage)
library(magick)
library(keras3)
install_keras(backend = "tensorflow")
setwd("C:/Users/Soham/Desktop/Projects/R-submissions/Lab 5")
pics <- c(
"plane1.jpeg",
"plane2.jpeg",
"plane3.jpeg",
"car1.jpeg",
"car2.jpeg",
"car3.jpeg"
)
mypic <- list()
for (i in 1:6) {
mypic[[i]] <- image_read(pics[i])
}
mypic[[1]]
mypic[[1]]
mypic <- list()
for (i in 1:6) {
mypic[[i]] <- image_read(pics[i])
}
mypic[[1]]
summary(mypic[[1]])
img <- image_read("car1.jpeg")
pixels <- image_data(
img,
channels = "gray"
)
pixels <- as.numeric(pixels)
hist(
pixels,
main = "Car Image Histogram",
xlab = "Pixel Intensity",
breaks = 256
)
images <- lapply(pics, function(x) {
image_resize(
image_read(x),
"64x64!"
)
})
image_vector <- as.numeric(
image_data(
images[[1]],
channels = "rgb"
)
)
length(image_vector)
x <- lapply(images, function(img) {
as.numeric(
image_data(
img,
channels = "rgb"
)
)
})
x <- do.call(rbind, x)
dim(x)
x <- x / 255
y_labels <- c(
"Plane",
"Plane",
"Plane",
"Car",
"Car",
"Car"
)
y_numeric <- ifelse(
y_labels == "Car",
0,
1
)
y <- to_categorical(
y_numeric,
num_classes = 2
)
model <- keras_model_sequential(
input_shape = c(ncol(x))
) |>
layer_dense(
units = 128,
activation = "relu"
) |>
layer_dense(
units = 64,
activation = "relu"
) |>
layer_dense(
units = 2,
activation = "softmax"
)
summary(model)
model |> compile(
optimizer = "adam",
loss = "categorical_crossentropy",
metrics = "accuracy"
)
history <- model |> fit(
x,
y,
batch_size = 32,
epochs = 30
)
evaluation <- model |> evaluate(
x,
y
)
print(evaluation)
predictions <- model |> predict(x)
predicted_class <- apply(
predictions,
1,
which.max
)
predicted_labels <- ifelse(
predicted_class == 1,
"Car",
"Plane"
)
prediction_result <- data.frame(
Image = pics,
Actual = y_labels,
Predicted = predicted_labels,
Car_Probability = round(predictions[, 1], 4),
Plane_Probability = round(predictions[, 2], 4)
)
print(prediction_result)
